{
  "name": "boom-bug-lab",
  "version": "0.1.0",
  "description": "擦炮虫虫实验室 —— 微型灾难物理沙盒（确定性模拟 + 回放 + 分享码）",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/*.js\" server.js eslint.config.js",
    "test": "tsc -p tsconfig.json && eslint . && node --test \"test/*.test.js\"",
    "start": "tsc -p tsconfig.json && node server.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.0"
  }
}
